{
  "manifest_version": 3,
  "name": "CityChina Saver",
  "version": "3.0.0",
  "description": "Salva paginas de vendedor/produto no CityChina para o usuario autenticado.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "*://*.goofish.com/*",
    "*://goofish.com/*",
    "https://phcgv-import.vercel.app/*",
    "http://127.0.0.1:8050/*",
    "http://localhost:8050/*",
    "http://127.0.0.1:5173/*",
    "http://localhost:5173/*",
    "https://*.ngrok-free.app/*",
    "https://*.ngrok.app/*",
    "https://*.ngrok.io/*",
    "https://*.ngrok-free.dev/*",
    "https://*.ngrok.dev/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://phcgv-import.vercel.app/*",
      "http://127.0.0.1:8050/*",
      "http://localhost:8050/*",
      "http://127.0.0.1:5173/*",
      "http://localhost:5173/*",
      "https://*.ngrok-free.app/*",
      "https://*.ngrok.app/*",
      "https://*.ngrok.io/*",
      "https://*.ngrok-free.dev/*",
      "https://*.ngrok.dev/*"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CityChina Saver"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.goofish.com/*", "*://goofish.com/*"],
      "css": ["style.css"],
      "js": ["content.js"]
    }
  ]
}